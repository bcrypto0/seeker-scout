node_modules/
# Not committed: the lockfile is generated by npm 11 locally, but EAS builds on
# npm 10, whose strict `npm ci` rejects it (npm 11 prunes optional native deps
# like utf-8-validate). With no lockfile, EAS uses lenient `npm install`, which
# resolves cleanly and still hoists the Expo core native modules.
package-lock.json
android/
ios/
.expo/
dist/
*.keystore
*-keypair.json
config.yaml
indexer/catalog.json
.env
# wrangler's local secret file — the worker now fails closed without
# CHAT_SECRET, so `wrangler dev` needs one, and it must never be committed.
.dev.vars
release/

# release APKs are build artifacts (EAS holds the canonical copies)
store-assets/*.apk
indexer/game-pool.last.json
# last good GET /vouch/aggregate, written by indexer/enrich-vouches.mjs
indexer/vouch-aggregate.last.json
